# MediTrust Backend Environment Configuration
# Copy this file to backend/.env and update values for your environment

PROJECT_NAME="MediTrust API"
ENVIRONMENT="development"
DEBUG=True

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="meditrust_db"

# Allowed CORS Origins (JSON list format)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000","http://localhost:5500","http://127.0.0.1:5500"]

# JWT Authentication Configuration
# Generate a secure secret key: openssl rand -hex 32
JWT_SECRET_KEY="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Argon2 Password Hashing Configuration
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
ARGON2_HASH_LEN=32
ARGON2_SALT_LEN=16
