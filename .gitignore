# ==============================================================================
# MediTrust .gitignore
# ==============================================================================

# Environment variables & secrets (Protects backend/.env)
.env
.env.*
backend/.env
backend/.env.*
!.env.example
!backend/.env.example

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments (Preserves .venv at project root from git tracking)
.venv/
env/
venv/
ENV/

# Build artifacts & distribution
build/
dist/
*.egg-info/
.eggs/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Editor & IDE settings
.vscode/
.idea/
*.swp
*.swo

# Operating System files
.DS_Store
Thumbs.db

# Uploaded hospital documents - private storage
backend/data/
backend/test_download/

\ No newline at end of file

# Local RAG audit and maintenance scripts
audit_db.py
backend/reset_mongodb.py
backend/cleanup_test_docs.py
backend/cleanup_test_docs2.py
backend/test_reingest.py
backend/add_content_hash.py
backend/add_content_hash_clean.py
backend/rebuild_faiss.py
backend/run_verification_tests.py
backend/sync_mongodb.py

# Local FAISS backup files
backend/backup_phase1_20261115_204311/
